{
  "name": "cs-visualized",
  "version": "0.2.0",
  "private": true,
  "description": "Computer science you can step through: interactive, tested simulations of networking, operating systems, databases and distributed systems. A static site with no dependencies at runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zch6a/cs-visualized.git"
  },
  "homepage": "https://zch6a.github.io/cs-visualized/",
  "bugs": {
    "url": "https://github.com/zch6a/cs-visualized/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "serve": "node scripts/serve.ts",
    "dev": "node scripts/build.ts && node scripts/serve.ts --watch",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "mutate": "node scripts/mutate.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
